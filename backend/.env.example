# ─── Environment ────────────────────────────────────────────────────────────────
# development | staging | production (anything else refuses to start). Every Redis key and
# pub/sub channel is prefixed with it. Staging/production require every provider credential below.
APP_ENV=development
PORT=4000
# Public base URL of this API (used in email links). Required in staging/production.
PUBLIC_API_URL=http://localhost:4000
# Comma-separated browser origins allowed by CORS (the native app does not need CORS), e.g. the web
# app's https://app.example.com. Empty in development = allow all; empty in staging/production = allow
# none (the web app then cannot reach the API; a warning is logged at startup).
CORS_ORIGINS=
# Express "trust proxy": <hop count> (e.g. 1 behind one load balancer) | <comma-separated proxy
# addresses/subnets> | false (clients connect directly). Required in staging/production, where `true`
# is refused (it would let any client spoof its IP through X-Forwarded-For). Development: anything.
TRUST_PROXY=false
# fatal | error | warn | info | debug | trace | silent (empty = debug in development, info otherwise)
LOG_LEVEL=

# ─── Data stores ───────────────────────────────────────────────────────────────
# MongoDB must be a replica set (transactions). The database name may be in the URI or below.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB_NAME=professionals
MONGODB_MAX_POOL_SIZE=20
REDIS_URL=redis://127.0.0.1:6379

# ─── Auth ──────────────────────────────────────────────────────────────────────
# HS256 secret of access tokens (30 min); refresh tokens are signed with a key derived from it.
# Generate one per environment: openssl rand -base64 48. The placeholder below only works in
# development: staging/production refuse placeholders and weak secrets.
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-of-32-chars-or-more
# Token iss/aud; default professionals-api:<APP_ENV> / professionals-app:<APP_ENV>.
JWT_ISSUER=
JWT_AUDIENCE=
# Google OAuth client ids whose id tokens are accepted. Web is required in staging/production; set the
# iOS / Android id of each native app you ship (a missing one is logged as a warning at startup).
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# ─── Image uploads (Cloudinary) ────────────────────────────────────────────────
# Either the URL or the three parts. Development without it: uploads answer 503.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email ─────────────────────────────────────────────────────────────────────
# Staging/production: Resend (required). Sender, e.g. "Professionals <no-reply@example.com>".
RESEND_API_KEY=
EMAIL_FROM=
# Development: Gmail SMTP with an app password (https://myaccount.google.com/apppasswords).
# Without SMTP_USER/SMTP_PASS emails are written to the log.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ─── Push notifications (Expo) ─────────────────────────────────────────────────
# Optional: only when "Enhanced push security" is enabled for the Expo project.
EXPO_ACCESS_TOKEN=

# ─── Geocoding (Nominatim) ─────────────────────────────────────────────────────
GEOCODER_URL=https://nominatim.openstreetmap.org
# Identify the app to the provider (required in staging/production by the usage policy).
GEOCODER_EMAIL=
GEOCODER_USER_AGENT=
GEOCODER_COUNTRY_CODES=il
# Spacing of provider calls across all instances (Nominatim's public API: at least 1000).
GEOCODER_MIN_INTERVAL_MS=1000

# ─── Processes ─────────────────────────────────────────────────────────────────
# Cron jobs run under Redis locks (one instance per tick). Disable all or some per process:
CRON_ENABLED=true
# Comma-separated names: offer-expiry, appointment-reminders, push-receipts, orphan-uploads
CRON_DISABLED_JOBS=
RATE_LIMIT_ENABLED=true
# Reject new passwords found in data breaches (Pwned Passwords k-anonymity API; fails open).
PASSWORD_BREACH_CHECK=true
SHUTDOWN_TIMEOUT_MS=10000
# Explorer refresh events to one professional are merged within this window (0 = each at once).
EXPLORER_EVENT_WINDOW_MS=2000
