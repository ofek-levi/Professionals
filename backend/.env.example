# ─── Environment ────────────────────────────────────────────────────────────────
# development | staging | production (anything else refuses to start). Every Redis key and
# pub/sub channel is prefixed with it. Staging/production require every provider credential below.
APP_ENV=development
PORT=4000
# Public base URL of this API (used in email links). Required in staging/production.
PUBLIC_API_URL=http://localhost:4000
# Comma-separated browser origins allowed by CORS (the native app does not need CORS).
# Empty in development = allow all; empty in staging/production = allow none.
CORS_ORIGINS=
# Express "trust proxy": false | true | <hop count> | <subnet list>. Set behind a load balancer.
TRUST_PROXY=false
# fatal | error | warn | info | debug | trace | silent (default: debug in development, info otherwise)
LOG_LEVEL=

# ─── Data stores ───────────────────────────────────────────────────────────────
# MongoDB must be a replica set (transactions). The database name may be in the URI or below.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB_NAME=professionals
MONGODB_MAX_POOL_SIZE=20
REDIS_URL=redis://127.0.0.1:6379

# ─── Auth ──────────────────────────────────────────────────────────────────────
# HS256 secret of access tokens (30 min). At least 32 random characters: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-of-32-chars-or-more
JWT_ISSUER=professionals-api
JWT_AUDIENCE=professionals-app
# Google OAuth client ids whose id tokens are accepted (web + iOS required in staging/production).
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# ─── Image uploads (Cloudinary) ────────────────────────────────────────────────
# Either the URL or the three parts. Development without it: uploads answer 503.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email ─────────────────────────────────────────────────────────────────────
# Staging/production: Resend (required). Sender, e.g. "Professionals <no-reply@example.com>".
RESEND_API_KEY=
EMAIL_FROM=
# Development: Gmail SMTP with an app password (https://myaccount.google.com/apppasswords).
# Without SMTP_USER/SMTP_PASS emails are written to the log.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ─── Push notifications (Expo) ─────────────────────────────────────────────────
# Optional: only when "Enhanced push security" is enabled for the Expo project.
EXPO_ACCESS_TOKEN=

# ─── Geocoding (Nominatim) ─────────────────────────────────────────────────────
GEOCODER_URL=https://nominatim.openstreetmap.org
# Identify the app to the provider (required in staging/production by the usage policy).
GEOCODER_EMAIL=
GEOCODER_USER_AGENT=
GEOCODER_COUNTRY_CODES=il

# ─── Processes ─────────────────────────────────────────────────────────────────
# Cron jobs run under Redis locks (one instance per tick). Disable all or some per process:
CRON_ENABLED=true
# Comma-separated names: offer-expiry, appointment-reminders, push-receipts, orphan-uploads
CRON_DISABLED_JOBS=
RATE_LIMIT_ENABLED=true
# Reject new passwords found in data breaches (Pwned Passwords k-anonymity API; fails open).
PASSWORD_BREACH_CHECK=true
SHUTDOWN_TIMEOUT_MS=10000
