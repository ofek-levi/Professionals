# Copy to `.env.local` (git-ignored) and adjust. Expo inlines EXPO_PUBLIC_* variables into the
# JavaScript bundle when it is built, so they are public: never put secrets here.
# Restart `npx expo start` (with --clear) after changing them.
# The Android APK action (.github/workflows/android-apk.yml) sets the same variables from the
# variables of the GitHub Environment it builds for (API_BASE_URL, EAS_PROJECT_ID, GOOGLE_*_CLIENT_ID,
# MAP_TILE_*) and writes google-services.json from the secret GOOGLE_SERVICES_JSON_BASE64.

# ── Environment ──────────────────────────────────────────────────────────────────────────────
# development (default) | staging | production
EXPO_PUBLIC_APP_ENV=development

# ── Backend ──────────────────────────────────────────────────────────────────────────────────
# API root, ending in /v1 (the realtime WebSocket is derived from it: ws(s)://…/v1/realtime).
# Development default: http://localhost:4000/v1 (web and the iOS simulator).
#   Android emulator: http://10.0.2.2:4000/v1
#   A phone on the same Wi-Fi: http://<your computer's LAN IP>:4000/v1
# Staging and production builds require an explicit https URL (the app refuses to start without it).
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/v1

# ── Push notifications (iOS/Android; the web has no push) ────────────────────────────────────
# EAS project id (`eas init` / expo.dev → project settings). Also written to app config
# `extra.eas.projectId` by app.config.ts. Unset → push is off (a warning in development).
EXPO_PUBLIC_EAS_PROJECT_ID=
# Not EXPO_PUBLIC: read by app.config.ts at build time. Path to the Firebase
# google-services.json (FCM is required for push on Android).
# GOOGLE_SERVICES_FILE=./google-services.json

# ── Google sign-in ───────────────────────────────────────────────────────────────────────────
# OAuth client ids from Google Cloud Console. "Continue with Google" is shown only on platforms
# whose client id is set (and not in Expo Go on iOS/Android). The backend must list the same ids.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# ── Map tiles (optional) ─────────────────────────────────────────────────────────────────────
# https URL template with {z}, {x}, {y}. Unset → OpenStreetMap tiles.
EXPO_PUBLIC_MAP_TILE_URL=
# Plain-text credit for a custom tile provider.
EXPO_PUBLIC_MAP_TILE_ATTRIBUTION=
